@namespace BaGet.Components.UI

<span class="@ComputedClass" @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => string.Join(" ", GetClasses());

    private IEnumerable<string> GetClasses()
    {
        yield return "inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2";

        yield return Variant switch
        {
            BadgeVariant.Default => "border-transparent bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] shadow hover:bg-[hsl(var(--primary))]/80",
            BadgeVariant.Secondary => "border-transparent bg-[hsl(var(--secondary))] text-[hsl(var(--secondary-foreground))] hover:bg-[hsl(var(--secondary))]/80",
            BadgeVariant.Destructive => "border-transparent bg-[hsl(var(--destructive))] text-[hsl(var(--destructive-foreground))] shadow hover:bg-[hsl(var(--destructive))]/80",
            BadgeVariant.Outline => "text-[hsl(var(--foreground))]",
            BadgeVariant.Success => "border-transparent bg-[hsl(var(--success))] text-[hsl(var(--success-foreground))] shadow",
            BadgeVariant.Warning => "border-transparent bg-[hsl(var(--warning))] text-[hsl(var(--warning-foreground))] shadow",
            _ => ""
        };

        if (!string.IsNullOrWhiteSpace(Class))
        {
            yield return Class;
        }
    }

    public enum BadgeVariant
    {
        Default,
        Secondary,
        Destructive,
        Outline,
        Success,
        Warning
    }
}
