@namespace BaGet.Components.UI

<div class="@ComputedClass" @attributes="AdditionalAttributes">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? DefaultValue { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<string> OnValueChange { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public string? ActiveTab { get; private set; }

    private string ComputedClass => Class ?? "";

    protected override void OnInitialized()
    {
        ActiveTab = DefaultValue;
    }

    public async Task SetActiveTab(string value)
    {
        ActiveTab = value;
        await OnValueChange.InvokeAsync(value);
        StateHasChanged();
    }
}
