@page "/"
@using BaGet.Core
@using BaGet.Protocol.Models
@using Humanizer
@inject ISearchService SearchService
@inject NavigationManager Navigation

<PageTitle>BaGet - Package Search</PageTitle>

<div class="space-y-6">
    @* Filters *@
    <div class="flex flex-wrap gap-4 items-center">
        <div class="flex items-center gap-2">
            <Label>Package Type:</Label>
            <select @bind="PackageType" @bind:after="Search" class="h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-ring">
                <option value="any">Any</option>
                <option value="dependency">Dependency</option>
                <option value="dotnettool">dotnet Tool</option>
                <option value="dotnettemplate">dotnet Template</option>
            </select>
        </div>
        <div class="flex items-center gap-2">
            <Label>Framework:</Label>
            <select @bind="Framework" @bind:after="Search" class="h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-ring">
                <option value="any">Any</option>
                <option value="net10.0">.NET 10</option>
                <option value="net9.0">.NET 9</option>
                <option value="net8.0">.NET 8</option>
                <option value="net7.0">.NET 7</option>
                <option value="net6.0">.NET 6</option>
                <option value="netstandard2.1">.NET Standard 2.1</option>
                <option value="netstandard2.0">.NET Standard 2.0</option>
            </select>
        </div>
        <div class="flex items-center gap-2">
            <input type="checkbox" id="prerelease" @bind="IncludePrerelease" @bind:after="Search"
                   class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
            <Label For="prerelease">Include Prerelease</Label>
        </div>
    </div>

    @* Results *@
    @if (IsLoading)
    {
        <div class="space-y-4">
            @for (var i = 0; i < 5; i++)
            {
                <Card>
                    <CardContent Class="p-4">
                        <Skeleton Class="h-6 w-1/3 mb-2" />
                        <Skeleton Class="h-4 w-2/3 mb-4" />
                        <Skeleton Class="h-4 w-1/2" />
                    </CardContent>
                </Card>
            }
        </div>
    }
    else if (Packages == null || !Packages.Any())
    {
        <Card>
            <CardContent Class="p-8 text-center">
                <svg class="mx-auto h-12 w-12 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
                <h3 class="text-lg font-semibold text-foreground mb-2">No packages found</h3>
                <p class="text-muted-foreground">Try adjusting your search or filters.</p>
            </CardContent>
        </Card>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var package in Packages)
            {
                <a href="/packages/@package.PackageId" class="block">
                    <Card Class="hover:shadow-md transition-shadow">
                        <CardContent Class="p-4">
                            <div class="flex items-start gap-4">
                                @if (!string.IsNullOrEmpty(package.IconUrl))
                                {
                                    <img src="@package.IconUrl" alt="@package.PackageId" class="w-12 h-12 rounded" onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded bg-muted flex items-center justify-center">
                                        <svg class="w-6 h-6 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    </div>
                                }
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="text-lg font-semibold text-foreground">@package.PackageId</h3>
                                        <Badge Variant="Badge.BadgeVariant.Secondary">@package.Version</Badge>
                                        @if (package.Version?.Contains("-") == true)
                                        {
                                            <Badge Variant="Badge.BadgeVariant.Warning">prerelease</Badge>
                                        }
                                    </div>
                                    <p class="text-sm text-muted-foreground mt-1 line-clamp-2">
                                        @(string.IsNullOrEmpty(package.Description) ? "No description provided." : package.Description)
                                    </p>
                                    <div class="flex items-center gap-4 mt-2 text-xs text-muted-foreground">
                                        @if (package.Authors?.Any() == true)
                                        {
                                            <span>by @string.Join(", ", package.Authors)</span>
                                        }
                                        @if (package.TotalDownloads > 0)
                                        {
                                            <span>@package.TotalDownloads.ToMetric() downloads</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </CardContent>
                    </Card>
                </a>
            }
        </div>

        @* Pagination *@
        @if (Packages.Count >= ResultsPerPage)
        {
            <div class="flex justify-center gap-2 mt-6">
                @if (PageIndex > 1)
                {
                    <Button Variant="Button.ButtonVariant.Outline" OnClick="PreviousPage">
                        Previous
                    </Button>
                }
                <span class="flex items-center px-4 text-sm text-muted-foreground">Page @PageIndex</span>
                <Button Variant="Button.ButtonVariant.Outline" OnClick="NextPage">
                    Next
                </Button>
            </div>
        }
    }
</div>

@code {
    private const int ResultsPerPage = 20;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "p")]
    public int PageIndex { get; set; } = 1;

    private string PackageType { get; set; } = "any";
    private string Framework { get; set; } = "any";
    private bool IncludePrerelease { get; set; } = true;
    private bool IsLoading { get; set; } = true;
    private IReadOnlyList<SearchResult>? Packages { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (PageIndex < 1) PageIndex = 1;
        await Search();
    }

    protected override async Task OnParametersSetAsync()
    {
        await Search();
    }

    private async Task Search()
    {
        IsLoading = true;
        StateHasChanged();

        var packageType = PackageType == "any" ? null : PackageType;
        var framework = Framework == "any" ? null : Framework;

        var result = await SearchService.SearchAsync(
            new SearchRequest
            {
                Skip = (PageIndex - 1) * ResultsPerPage,
                Take = ResultsPerPage,
                IncludePrerelease = IncludePrerelease,
                IncludeSemVer2 = true,
                PackageType = packageType,
                Framework = framework,
                Query = Query,
            },
            CancellationToken.None);

        Packages = result.Data;
        IsLoading = false;
    }

    private void PreviousPage()
    {
        if (PageIndex > 1)
        {
            PageIndex--;
            UpdateUrl();
        }
    }

    private void NextPage()
    {
        PageIndex++;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var url = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(Query) ? null : Query,
            ["p"] = PageIndex > 1 ? PageIndex : null
        });
        Navigation.NavigateTo(url);
    }
}
