@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="min-h-screen flex flex-col">
    <header>
        <nav class="bg-primary border-b border-primary/20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-14">
                    <div class="flex items-center space-x-6">
                        <a href="/" class="text-primary-foreground font-semibold text-lg hover:text-primary-foreground/80 transition-colors">
                            BaGet
                        </a>
                        <div class="hidden sm:flex space-x-1">
                            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                                Packages
                            </NavLink>
                            <NavLink href="/upload" class="nav-link">
                                Upload
                            </NavLink>
                            <a href="https://loic-sharma.github.io/BaGet/" target="_blank" rel="noopener noreferrer" class="nav-link">
                                Documentation
                            </a>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <AuthorizeView>
                            <Authorized>
                                <NavLink href="/account/apikeys" class="nav-link">
                                    API Keys
                                </NavLink>
                                <span class="text-primary-foreground/70 text-sm hidden sm:inline">@context.User.Identity?.Name</span>
                                <form method="post" action="/account/logout" class="inline">
                                    <button type="submit" class="nav-link">
                                        Sign out
                                    </button>
                                </form>
                            </Authorized>
                            <NotAuthorized>
                                <NavLink href="/account/login" class="nav-link">
                                    Sign in
                                </NavLink>
                                <a href="/account/register" class="bg-accent hover:bg-accent/90 text-accent-foreground px-3 py-1.5 text-sm font-medium rounded transition-colors">
                                    Register
                                </a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>

            <div class="bg-primary/90 border-t border-primary-foreground/10">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                    <SearchBar />
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
        @Body
    </main>

    <footer class="border-t border-border bg-card">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <p class="text-sm text-muted-foreground">
                    Powered by <a href="https://github.com/loic-sharma/BaGet" target="_blank" class="text-primary hover:underline">BaGet</a>
                </p>
                <div class="flex items-center space-x-4">
                    <a href="https://github.com/loic-sharma/BaGet" target="_blank" class="text-muted-foreground hover:text-foreground transition-colors">
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </footer>
</div>

<style>
    .nav-link {
        @@apply text-primary-foreground/80 hover:text-primary-foreground px-3 py-2 text-sm font-medium transition-colors;
    }
    .nav-link.active {
        @@apply text-primary-foreground;
    }
</style>
