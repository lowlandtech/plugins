@page
@model BaGet.Web.Pages.Account.ApiKeysModel
@{
    ViewData["Title"] = "API Keys";
}

<div class="max-w-3xl mx-auto py-8">
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h1 class="text-2xl font-bold text-gray-900">API Keys</h1>
            <p class="mt-1 text-sm text-gray-500">
                Use your API key to push packages to this server.
            </p>
        </div>

        <div class="px-6 py-4">
            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
                    @Model.StatusMessage
                </div>
            }

            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Your API Key</label>
                    <div class="flex items-center space-x-2">
                        <div x-data="{ show: false }" class="flex-1 flex items-center">
                            <input :type="show ? 'text' : 'password'"
                                   value="@Model.ApiKey"
                                   readonly
                                   class="flex-1 px-3 py-2 border border-gray-300 rounded-l-md bg-gray-50 font-mono text-sm focus:outline-none" />
                            <button type="button"
                                    @@click="show = !show"
                                    class="px-3 py-2 border border-l-0 border-gray-300 bg-white hover:bg-gray-50 text-gray-600">
                                <svg x-show="!show" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg x-show="show" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                </svg>
                            </button>
                            <button type="button"
                                    onclick="copyToClipboard('@Model.ApiKey')"
                                    class="px-3 py-2 border border-l-0 border-gray-300 rounded-r-md bg-white hover:bg-gray-50 text-gray-600"
                                    title="Copy to clipboard">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-200">
                    <h3 class="text-sm font-medium text-gray-700 mb-2">Permissions</h3>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex items-center">
                            @if (Model.CanPushPackages)
                            {
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            }
                            else
                            {
                                <svg class="h-5 w-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            }
                            Push packages
                        </li>
                        <li class="flex items-center">
                            @if (Model.CanDeletePackages)
                            {
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            }
                            else
                            {
                                <svg class="h-5 w-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            }
                            Delete packages
                        </li>
                    </ul>
                </div>

                <div class="pt-4 border-t border-gray-200">
                    <h3 class="text-sm font-medium text-gray-700 mb-2">Usage</h3>
                    <div class="bg-gray-900 rounded-md p-4 overflow-x-auto">
                        <pre class="text-sm text-gray-100"><code>dotnet nuget push MyPackage.1.0.0.nupkg \
  --source @(ViewContext.HttpContext.Request.Scheme)://@(ViewContext.HttpContext.Request.Host) \
  --api-key YOUR_API_KEY</code></pre>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-200">
                    <h3 class="text-sm font-medium text-gray-700 mb-2">Regenerate API Key</h3>
                    <p class="text-sm text-gray-500 mb-3">
                        If your API key has been compromised, you can regenerate it. This will invalidate your current key.
                    </p>
                    <form method="post" asp-page-handler="Regenerate" onsubmit="return confirm('Are you sure you want to regenerate your API key? Your current key will stop working immediately.');">
                        <button type="submit"
                                class="px-4 py-2 border border-red-300 text-red-700 bg-red-50 hover:bg-red-100 rounded-md text-sm font-medium transition-colors">
                            Regenerate API Key
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function() {
        alert('API key copied to clipboard');
    }).catch(function(err) {
        console.error('Failed to copy: ', err);
    });
}
</script>
