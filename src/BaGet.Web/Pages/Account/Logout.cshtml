@page
@model BaGet.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="min-h-[60vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 text-center">
        <div>
            <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
                Sign out
            </h2>
            <p class="mt-2 text-gray-600">
                Are you sure you want to sign out?
            </p>
        </div>

        <form method="post" class="mt-8">
            <button type="submit"
                    class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                Sign out
            </button>
        </form>

        <p class="text-sm text-gray-500">
            <a asp-page="/Index" class="font-medium text-primary hover:text-primary/80">
                Cancel and go back
            </a>
        </p>
    </div>
</div>
